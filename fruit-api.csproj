<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>fruit_api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FirebaseAdmin" Version="3.7.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.20" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.7" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Fruit.*/**/*.cs" />
    <ProjectReference Include="Fruit.Application/Fruit.Application.csproj" />
    <ProjectReference Include="Fruit.Infrastructure/Fruit.Infrastructure.csproj" />
  </ItemGroup>
</Project>


